{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe SurgeTrix account profile and preferences without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID owning this profile.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Minecraft display username.",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_ .-]+$"
        },
        "plan": {
          "type": "string",
          "description": "Account tier.",
          "enum": ["Free", "Plus", "Pro", "Business"]
        },
        "preferredTheme": {
          "type": "string",
          "description": "Saved SurgeTrix visual style.",
          "enum": ["cyber", "obsidian", "bedrock", "daylight"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "username", "plan", "preferredTheme", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record containing verified user email.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID owning this private info document.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Account email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "CustomDomain": {
      "title": "CustomDomain",
      "description": "Public shareable free SurgeTrix server domain mapping pointing to a Minecraft server host and port.",
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "description": "URL handle for /s/{handle}.",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of domain owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serverName": {
          "type": "string",
          "description": "Minecraft server display name.",
          "minLength": 2,
          "maxLength": 64
        },
        "targetHost": {
          "type": "string",
          "description": "Public server hostname or IPv4.",
          "minLength": 3,
          "maxLength": 253,
          "pattern": "^[a-zA-Z0-9.-]+$"
        },
        "targetPort": {
          "type": "integer",
          "description": "Minecraft server port (1-65535)."
        },
        "edition": {
          "type": "string",
          "description": "Minecraft edition.",
          "enum": ["Java", "Bedrock", "Crossplay"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["handle", "ownerUid", "serverName", "targetHost", "targetPort", "edition", "createdAt", "updatedAt"]
    },
    "Plugin": {
      "title": "Plugin",
      "description": "Owner-published Minecraft plugin resource in BuiltByBit-style marketplace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique plugin ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "description": "URL-safe plugin slug.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Plugin display title.",
          "minLength": 2,
          "maxLength": 64
        },
        "tagline": {
          "type": "string",
          "description": "Short resource tagline.",
          "minLength": 6,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "description": "Full plugin overview documentation.",
          "minLength": 10,
          "maxLength": 10000
        },
        "category": {
          "type": "string",
          "description": "BuiltByBit resource category.",
          "enum": ["Anti-Cheat", "Economy", "Administration", "Mechanics", "Optimization", "Chat & Social", "Minigames", "Developer API"]
        },
        "platforms": {
          "type": "array",
          "description": "Supported server platforms."
        },
        "mcVersions": {
          "type": "array",
          "description": "Supported Minecraft versions."
        },
        "priceLabel": {
          "type": "string",
          "description": "Price badge text.",
          "minLength": 1,
          "maxLength": 24
        },
        "featured": {
          "type": "boolean",
          "description": "Featured marketplace flag."
        },
        "authorName": {
          "type": "string",
          "description": "Owner display label.",
          "minLength": 2,
          "maxLength": 32
        },
        "currentVersion": {
          "type": "string",
          "description": "Active plugin release version.",
          "minLength": 1,
          "maxLength": 24
        },
        "fileName": {
          "type": "string",
          "description": "Uploaded archive filename.",
          "minLength": 0,
          "maxLength": 128
        },
        "fileSize": {
          "type": "integer",
          "description": "Uploaded archive byte length."
        },
        "sha256": {
          "type": "string",
          "description": "Archive SHA-256 hex digest.",
          "minLength": 0,
          "maxLength": 128
        },
        "supportUrl": {
          "type": "string",
          "description": "Optional support URL.",
          "minLength": 0,
          "maxLength": 256
        },
        "versionsJson": {
          "type": "string",
          "description": "Serialized release version history.",
          "minLength": 2,
          "maxLength": 50000
        },
        "ownerUid": {
          "type": "string",
          "description": "Verified platform owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Visibility and moderation status.",
          "enum": ["published", "pending", "hidden"]
        },
        "downloads": {
          "type": "integer",
          "description": "Total verified download counter."
        },
        "createdAtIso": {
          "type": "string",
          "description": "ISO creation timestamp.",
          "minLength": 10,
          "maxLength": 40
        },
        "updatedAtIso": {
          "type": "string",
          "description": "ISO update timestamp.",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["id", "slug", "name", "tagline", "description", "category", "platforms", "mcVersions", "priceLabel", "featured", "authorName", "currentVersion", "fileName", "fileSize", "sha256", "supportUrl", "versionsJson", "ownerUid", "status", "downloads", "createdAtIso", "updatedAtIso", "createdAt", "updatedAt"]
    },
    "PluginFileChunk": {
      "title": "PluginFileChunk",
      "description": "Base64-encoded binary archive chunk for direct static-host downloads via Firestore.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Chunk document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pluginId": {
          "type": "string",
          "description": "Parent plugin ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "versionId": {
          "type": "string",
          "description": "Plugin release version ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "index": {
          "type": "integer",
          "description": "Zero-based chunk index."
        },
        "dataBase64": {
          "type": "string",
          "description": "Base64 slice of plugin binary.",
          "minLength": 1,
          "maxLength": 750000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["id", "pluginId", "versionId", "index", "dataBase64", "createdAt"]
    },
    "PluginReview": {
      "title": "PluginReview",
      "description": "Verified user star rating and review for a published plugin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Review ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pluginId": {
          "type": "string",
          "description": "Parent plugin ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "description": "Review author UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Review author display name.",
          "minLength": 2,
          "maxLength": 32
        },
        "rating": {
          "type": "integer",
          "description": "Star rating from 1 to 5."
        },
        "title": {
          "type": "string",
          "description": "Short review headline.",
          "minLength": 1,
          "maxLength": 80
        },
        "comment": {
          "type": "string",
          "description": "Detailed review body.",
          "minLength": 4,
          "maxLength": 1500
        },
        "testedVersion": {
          "type": "string",
          "description": "Minecraft version tested.",
          "minLength": 1,
          "maxLength": 24
        },
        "ownerReply": {
          "type": "string",
          "description": "Optional reply from drminemc@gmail.com.",
          "minLength": 1,
          "maxLength": 1000
        },
        "ownerRepliedAt": {
          "type": "string",
          "description": "ISO timestamp of owner reply.",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAtIso": {
          "type": "string",
          "description": "ISO creation timestamp.",
          "minLength": 10,
          "maxLength": 40
        },
        "updatedAtIso": {
          "type": "string",
          "description": "ISO update timestamp.",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["id", "pluginId", "authorUid", "authorName", "rating", "title", "comment", "testedVersion", "createdAt", "updatedAt"]
    },
    "CommunityRequest": {
      "title": "CommunityRequest",
      "description": "Community tool request post subject to Owner Dashboard moderation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique request ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Request headline.",
          "minLength": 3,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Detailed request summary.",
          "minLength": 10,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "description": "Tool request category.",
          "enum": ["Minecraft Tools", "Server Owner Tools", "Player Utilities", "Developer Utilities"]
        },
        "authorUid": {
          "type": "string",
          "description": "Verified submitter UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Submitter display name without PII.",
          "minLength": 2,
          "maxLength": 32
        },
        "votes": {
          "type": "integer",
          "description": "Community upvote total."
        },
        "status": {
          "type": "string",
          "description": "Moderation and roadmap status.",
          "enum": ["Under Review", "Planned", "In Progress", "Shipped"]
        },
        "createdAtIso": {
          "type": "string",
          "description": "ISO creation timestamp.",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["id", "title", "description", "category", "authorUid", "authorName", "votes", "status", "createdAtIso", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores each signed-up user's SurgeTrix username, plan tier, and preferred visual style."
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Strictly owner-only PII subcollection storing user email address."
    },
    "/domains/{handle}": {
      "schema": { "$ref": "#/entities/CustomDomain" },
      "description": "Stores verified free shareable /s/{handle} Minecraft server domain mappings without PII."
    },
    "/plugins/{pluginId}": {
      "schema": { "$ref": "#/entities/Plugin" },
      "description": "Minecraft plugin catalog and pending submissions moderated by the verified owner."
    },
    "/plugins/{pluginId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/PluginFileChunk" },
      "description": "Binary archive chunks for plugin downloads when hosted statically."
    },
    "/plugins/{pluginId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/PluginReview" },
      "description": "User reviews and Owner replies for plugins."
    },
    "/community_requests/{requestId}": {
      "schema": { "$ref": "#/entities/CommunityRequest" },
      "description": "Community tool request posts moderated in Owner Dashboard."
    }
  }
}
